-        np.maximum.at(peak, lab.ravel(), prob.ravel())
-        keep &= peak > p.seed_thresh
+        maps = seed_maps or [prob]
+        need = min_votes if min_votes is not None else (len(maps) + 1) // 2
+        keep &= seed_votes(lab, n, maps, p.seed_thresh) >= need
     keep[0] = False
     fg = keep[lab].astype(np.uint8)
 
