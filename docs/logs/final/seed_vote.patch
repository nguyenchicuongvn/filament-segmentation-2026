diff --git a/tests/test_seed_vote.py b/tests/test_seed_vote.py
new file mode 100644
index 0000000..44c0daf
--- /dev/null
+++ b/tests/test_seed_vote.py
@@ -0,0 +1,62 @@
+"""Seed vote over sub-ensemble maps (instances_lowres seed_maps, instance_features prob_maps)."""
+import sys
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+
+from filseg.dl import PostParams, instances_lowres  # noqa: E402
+from filseg.instfilter import FEATURES, instance_features  # noqa: E402
+
+POST = PostParams(thresh=0.5, min_area=10, mode="hyst", seed_thresh=0.9)
+
+
+def _maps() -> tuple[np.ndarray, list[np.ndarray]]:
+    """Three bars; their peaks in 5 "pair" maps exceed 0.9 in 5, 3 and 2 of them. The pool is the mean."""
+    seeded = {0: 5, 1: 3, 2: 2}
+    pairs = []
+    for k in range(5):
+        m = np.zeros((64, 64), np.float32)
+        for bar, n in seeded.items():
+            m[10 + 20 * bar:14 + 20 * bar, 8:40] = 0.7
+            m[12 + 20 * bar, 20] = 0.95 if k < n else 0.8
+        pairs.append(m)
+    return np.mean(pairs, 0), pairs
+
+
+def test_single_map_is_the_default_rule():
+    rng = np.random.default_rng(0)
+    pool, _ = _maps()
+    pool = np.clip(pool + rng.normal(0, 0.1, pool.shape), 0, 1).astype(np.float32)
+    inst = instances_lowres(pool, POST)
+    assert inst.max() > 0
+    assert np.array_equal(inst, instances_lowres(pool, POST, seed_maps=[pool]))
+    gray = rng.integers(0, 255, (128, 128), dtype=np.uint8)
+    assert np.array_equal(instance_features(inst, pool, gray),
+                          instance_features(inst, pool, gray, prob_maps=[pool]))
+
+
+def test_majority_vote_keeps_components_seeded_in_3_of_5():
+    pool, pairs = _maps()
+    # pooled peaks are 0.95, 0.89 and 0.86: on the pool itself only the first bar is seeded
+    assert instances_lowres(pool, POST).max() == 1
+    inst = instances_lowres(pool, POST, seed_maps=pairs)
+    assert inst.max() == 2 and inst[12, 20] > 0 and inst[32, 20] > 0 and inst[52, 20] == 0
+    # the extent is the pooled component, not a pair's
+    assert np.array_equal(inst > 0, (pool > 0.5) & (np.arange(64)[:, None] < 40))
+    for votes, n in [(1, 3), (2, 3), (3, 2), (4, 1), (5, 1)]:
+        assert instances_lowres(pool, POST, seed_maps=pairs, min_votes=votes).max() == n
+
+
+def test_probability_features_are_averaged_over_maps():
+    pool, pairs = _maps()
+    inst = instances_lowres(pool, POST, seed_maps=pairs)
+    gray = np.full((64, 64), 100, np.uint8)
+    f = instance_features(inst, pool, gray, prob_maps=pairs)
+    each = np.stack([instance_features(inst, m, gray) for m in pairs])
+    cols = [FEATURES.index(n) for n in ("mean_prob", "max_prob", "p25_prob", "frac_conf")]
+    rest = [i for i in range(len(FEATURES)) if i not in cols]
+    assert np.allclose(f[:, cols], each.mean(0)[:, cols], atol=1e-6)
+    assert np.array_equal(f[:, rest], each[0][:, rest])
+    assert np.isclose(f[1, FEATURES.index("max_prob")], (3 * 0.95 + 2 * 0.8) / 5)
