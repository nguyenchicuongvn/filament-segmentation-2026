+def instances_lowres(prob: np.ndarray, p: PostParams, group: np.ndarray | None = None,
+                     seed_maps: list[np.ndarray] | None = None, min_votes: int | None = None) -> np.ndarray:
+    """Instance labels at the probability map's resolution.
+
+    `seed_maps` (mode hyst only, optional): the components and their extent still come from `prob`,
+    but the seed test "peak > seed_thresh" is made on each of these maps and a component is kept
+    when it passes in at least `min_votes` of them (default: a majority, ceil(n / 2)). This is for
+    a pool of many models whose seed_thresh was tuned on maps averaging fewer models: averaging
+    lowers the peaks, so the same threshold is stricter on the pool. Pass the maps of sub-ensembles
+    of the size the threshold was tuned on. Without seed_maps (or with [prob]) the test is on `prob`.
+    """
     fg = (prob > p.thresh).astype(np.uint8)
     n, lab, stats, _ = cv2.connectedComponentsWithStats(fg, 8)
     keep = stats[:, cv2.CC_STAT_AREA] >= p.min_area
     if p.mode == "hyst":
